---
import "../styles/global.css";
import { faviconUrl } from "../config/favicon";
interface Props {
  title?: string;
}
const { title = "HulettCraft" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title><meta
      name="description"
      content="HulettCraft community worlds, screenshots, and server information."
    /><link
      rel="icon"
      type="image/png"
      sizes="any"
      href={faviconUrl()}
      data-server-favicon
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body
    ><a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <strong class="site-title">
          <a href="/">HulettCraft</a>
        </strong>

        <!-- Hamburger -->
        <button
          class="nav-toggle"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="site-navigation"
          type="button"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav id="site-navigation" class="site-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/hytale">Hytale</a>
          <a href="/worlds">Worlds</a>
          <a href="/gallery">Gallery</a>
          <a href="/community">Community</a>
          <a href="/status">Status</a>
          <a href="/admin/login">Admin</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>© {new Date().getFullYear()} HulettCraft</span>
        <span class="muted">A long-running survival community</span>
      </div>
    </footer>
    <script>
      import "../scripts/navigation";
      import "../scripts/favicon";
    </script>
  </body>
</html>

---
import "../styles/global.css";
import { faviconUrl } from "../config/favicon";
interface Props {
  title?: string;
}
const { title = "HulettCraft" } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const navigation = [
  ["/", "Home"],
  ["/hytale", "Hytale"],
  ["/worlds", "Worlds"],
  ["/gallery", "Gallery"],
  ["/community", "Community"],
  ["/status", "Status"],
  ["/join", "Join"],
  ["/admin/login", "Admin"],
];
function isCurrent(href: string) {
  if (href === "/admin/login")
    return currentPath === "/admin" || currentPath.startsWith("/admin/");
  return (
    currentPath === href || (href !== "/" && currentPath.startsWith(href + "/"))
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title><meta
      name="description"
      content="HulettCraft community worlds, screenshots, and server information."
    /><link
      rel="icon"
      type="image/png"
      sizes="any"
      href={faviconUrl()}
      data-server-favicon
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body
    ><a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <strong class="site-title">
          <a href="/">
            <svg
              class="brand-block"
              width="28"
              height="32"
              viewBox="0 0 28 32"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M14 1 27 8 14 15 1 8Z" fill="#9bcaff"></path>
              <path d="M1 8 14 15 14 30 1 23Z" fill="#2863a6"></path>
              <path d="M14 15 27 8 27 23 14 30Z" fill="#4b92df"></path>
              <path
                d="M14 1 27 8 27 23 14 30 1 23 1 8Z"
                fill="none"
                stroke="#c1deff"
                stroke-opacity=".45"></path>
            </svg>
            <span>HulettCraft</span>
          </a>
        </strong>

        <!-- Hamburger -->
        <button
          class="nav-toggle"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="site-navigation"
          type="button"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav id="site-navigation" class="site-nav" aria-label="Main navigation">
          {
            navigation.map(([href, label]) => (
              <a
                href={href}
                aria-current={isCurrent(href) ? "page" : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>© {new Date().getFullYear()} HulettCraft</span>
        <span class="muted">A long-running survival community</span>
      </div>
    </footer>
    <script>
      import "../scripts/navigation";
      import "../scripts/favicon";
    </script>
  </body>
</html>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <h1>Hytale (Beta)</h1>
    <p>
      Our next-generation sandbox world — experimental, evolving, and open to
      early community exploration.
    </p>
  </section>

  <!-- About -->
  <section class="hero" style="padding-top: 1rem;">
    <p
      style="
        max-width: 760px;
        margin: 0 auto;
        color: var(--muted);
        line-height: 1.6;
      "
    >
      The HulettCraft Hytale server is an active beta environment focused on
      exploration, experimentation, and early content testing. Expect changes,
      resets, and new features as the game evolves.
    </p>
  </section>

  <!-- Join Info -->
  <section class="server-grid">
    <div class="card">
      <h3>Join the Server</h3>
      <p style="color: var(--muted);">
        Connect using the address below. This server is currently in beta.
      </p>

      <button
        type="button"
        class="ip copyable"
        data-copy="hytale.hulettcraft.com"
        title="Click to copy"
      >
        hytale.hulettcraft.com
      </button>

      <div class="card-actions">
        <a href="/status" class="status-link"> View server status → </a>
      </div>
    </div>

    <div class="card">
      <h3>Beta Notice</h3>
      <p style="color: var(--muted);">
        Progress may reset. Features may change. Feedback is welcome and
        encouraged.
      </p>
    </div>
  </section>
</BaseLayout>

---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServerState from "../components/ServerState.astro";
import { SERVERS } from "../config/servers";
---

<BaseLayout>
  <PageHero>
    <h1>Network Status</h1><p>
      Live operational status for HulettCraft services
    </p>
  </PageHero>
  <section class="server-grid">
    {
      SERVERS.map((server) => (
        <div class="card card-link status-card">
          <a
            class="card-overlay"
            href={
              server.id === "hytale"
                ? "/hytale"
                : server.id === "modded"
                  ? "/modded"
                  : server.gallery
            }
            aria-label={server.title}
          />
          <>
            <h3>{server.title}</h3>
            <div class="node">
              Node: <strong>{server.node}</strong>
            </div>
          </>
          <button
            type="button"
            class="ip copyable"
            data-copy={server.address}
            title="Click to copy"
          >
            {server.address}
          </button>
          <ServerState id={server.id} detailed />
        </div>
      ))
    }
  </section>
  <p class="muted center">
    Server checks refresh every minute. Minecraft uses mcstatus.io; Hytale uses
    its game-server query service. An unavailable check does not confirm that a
    server is offline.
  </p>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <h1>Network Status</h1>
    <p>Live operational status for all HulettCraft services</p>
  </section>

  <!-- Servers -->
  <section class="server-grid">

    <!-- Vanilla SMP -->
    <div class="card" data-host="108.214.93.42" data-port="25565">
      <h3>Vanilla SMP</h3>
      <div class="node">Node: HulettCraft</div>
      <div class="ip">play.hulettcraft.com</div>
      <div class="status">Checking…</div>
    </div>

    <!-- Creative -->
    <div class="card" data-host="107.221.146.250" data-port="25566">
      <h3>Creative Server</h3>
      <div class="node">Node: CloudCraft</div>
      <div class="ip">creative.hulettcraft.com</div>
      <div class="status">Checking…</div>
    </div>

    <!-- Seasonal / Modded -->
    <div class="card">
      <h3>Seasonal / Modded</h3>
      <div class="node">Node: CloudCraft</div>
      <div class="ip">modded.hulettcraft.com</div>
      <div class="status">🔴 Offline</div>
    </div>

    <!-- Hytale -->
    <div class="card">
      <h3>Hytale (Beta)</h3>
      <div class="node">Node: CloudCraft</div>
      <div class="ip">hytale.hulettcraft.com</div>
      <div class="status" id="hytale-status">Checking…</div>
      <small style="color: var(--muted);">
        Status reflects world map availability
      </small>
    </div>

  </section>

  <script type="module">
    // -------------------------
    // Minecraft status checks
    // -------------------------
    async function checkMinecraft(card) {
      const host = card.dataset.host;
      const port = card.dataset.port;
      if (!host || !port) return;

      const statusEl = card.querySelector(".status");

      try {
        const res = await fetch(
          `https://api.mcstatus.io/v2/status/java/${host}:${port}`
        );
        const data = await res.json();

        if (data.online) {
          statusEl.innerHTML =
            `🟢 Online — ${data.players.online}/${data.players.max} players<br>` +
            `<small>Version: ${data.version.name_clean}</small>`;
        } else {
          statusEl.innerHTML = "🔴 Offline";
        }
      } catch (err) {
        statusEl.innerHTML = "⚠️ Status unavailable";
      }
    }

    document
      .querySelectorAll(".card[data-host]")
      .forEach(checkMinecraft);

    // -------------------------
    // Hytale status via map
    // -------------------------
    async function checkHytaleMap() {
      const statusEl = document.getElementById("hytale-status");

      try {
        await fetch("https://hpmap.hulettcraft.com", {
          mode: "no-cors",
          cache: "no-store"
        });

        // If fetch does not throw, the map is reachable
        statusEl.innerHTML = "🟢 Online — world map active";
      } catch (err) {
        statusEl.innerHTML = "🔴 Offline";
      }
    }

    checkHytaleMap();
  </script>
</BaseLayout>

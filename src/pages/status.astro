---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServerState from "../components/ServerState.astro";
import { SERVERS } from "../config/servers";
---

<BaseLayout>
  <section class="hero">
    <h1>Network Status</h1><p>
      Live operational status for HulettCraft services
    </p>
  </section>
  <section class="server-grid">
    {
      SERVERS.map((server) => (
        <div class="card card-link status-card">
          <a
            class="card-overlay"
            href={server.id === "hytale" ? "/hytale" : server.gallery}
            aria-label={server.title}
          />
          <>
            <h3>{server.title}</h3>
            <div class="node">
              Node: <strong>{server.node}</strong>
            </div>
          </>
          <button
            type="button"
            class="ip copyable"
            data-copy={server.address}
            title="Click to copy"
          >
            {server.address}
          </button>
          <ServerState id={server.id} detailed />
          {server.id === "hytale" && (
            <small class="muted">
              A reliable game-server health check is not configured.
            </small>
          )}
        </div>
      ))
    }
  </section>
  <p class="muted center">
    Minecraft status is provided by mcstatus.io and refreshed every minute.
    Provider errors are shown as unavailable.
  </p>
</BaseLayout>

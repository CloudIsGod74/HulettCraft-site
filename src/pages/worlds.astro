---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

  <!-- Hero -->
  <section class="hero">
    <h1>Worlds of HulettCraft</h1>
    <p>
        Each world has its own story.
	Explore active worlds below, then dive deeper into their history,
	screenshots, and seasons.
    </p>
  </section>

  <section class="server-grid">

    <!-- HulettCraft SMP -->
    <div class="card card-link">
  	<a href="/gallery/hulettcraft" class="card-overlay" aria-label="HulettCraft SMP"></a>

    <h3>
   	 <span class="status-dot online"></span>
   	 HulettCraft SMP
    </h3>

    <p style="color: var(--muted);">
      Our primary world. Long-running, lightly governed, and built around
      trust, cooperation, and player-driven projects.
    </p>

    <div
      class="ip copyable"
      data-copy="play.hulettcraft.com"
      title="Click to copy"
    >
      play.hulettcraft.com
    </div>
  </div>

    <!-- Creative -->
     <div class="card card-link">
  	<a href="/gallery/creative" class="card-overlay" aria-label="Creative Server"></a>

     <h3>
   	 <span class="status-dot online"></span>
   	 Creative Server
     </h3>

     <p style="color: var(--muted);">
       A shared creative environment for large-scale builds, testing ideas, and collaborative construction.
     </p>

    <div
      class="ip copyable"
      data-copy="creative.hulettcraft.com"
      title="Click to copy"
    >
      creative.hulettcraft.com
    </div>
  </div>

    <!-- Seasonal / Modded -->
    <div class="card card-link">
	<a href="/gallery/modded" class="card-overlay" aria-label="Seasonal/Modded"></a>
      <h3>
        <span class="status-dot checking"></span>
        Seasonal / Modded
      </h3>

      <p style="color: var(--muted);">
        Rotating worlds with custom rules, mods, or limited-time themes.
        These worlds change as new ideas are explored.
      </p>

      <div
        class="ip copyable"
        data-copy="modded.hulettcraft.com"
        title="Click to copy"
      >
        modded.hulettcraft.com
      </div>
    </div>

    <!-- Hytale -->
    <div class="card card-link">
	<a href="/gallery/hytale" class="card-overlay" aria-label="Hytale (Beta)"></a>
      <h3>
        <span class="status-dot checking"></span>
        Hytale (Beta)
      </h3>

      <p style="color: var(--muted);">
        Our next-generation sandbox world, currently in active beta.
        Experimental features, evolving content, and early exploration.
      </p>

      <div
        class="ip copyable"
        data-copy="hytale.hulettcraft.com"
        title="Click to copy"
      >
        hytale.hulettcraft.com
      </div>
    </div>

  </section>

  <!-- Copy-to-clipboard -->
  <script type="module">
    document.querySelectorAll(".copyable").forEach(el => {
      el.addEventListener("click", async () => {
        const value = el.dataset.copy;
        try {
          await navigator.clipboard.writeText(value);
          el.classList.add("copied");
          el.textContent = "Copied!";
          setTimeout(() => {
            el.textContent = value;
            el.classList.remove("copied");
          }, 1200);
        } catch {
          alert("Copy failed");
        }
      });
    });
  </script>

  <!-- Load status from Status page source of truth -->
  <script type="module">
    async function loadStatuses() {
      try {
        const res = await fetch("/api/status.json");
        const statuses = await res.json();

        document.querySelectorAll("[data-world]").forEach(card => {
          const world = card.dataset.world;
          const dot = card.querySelector(".status-dot");

          dot.className = "status-dot";

          switch (statuses[world]) {
            case "online":
              dot.classList.add("online");
              break;
            case "offline":
              dot.classList.add("offline");
              break;
            case "online-beta":
              dot.classList.add("online", "beta");
              break;
            default:
              dot.classList.add("unknown");
          }
        });
      } catch {
        document
          .querySelectorAll(".status-dot")
          .forEach(dot => dot.classList.add("unknown"));
      }
    }

    loadStatuses();
  </script>

</BaseLayout>

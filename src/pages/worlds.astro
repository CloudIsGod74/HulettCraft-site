---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServerState from "../components/ServerState.astro";
import { SERVERS } from "../config/servers";
---

<BaseLayout>
  <section class="hero">
    <h1>Worlds of HulettCraft</h1><p>
      Each world has its own story. Explore active worlds below, then dive
      deeper into their history, screenshots, and seasons.
    </p>
  </section>
  <section class="server-grid">
    {
      SERVERS.map((server) => (
        <div class="card card-link">
          <a
            href={server.gallery}
            class="card-overlay"
            aria-label={server.title}
          />
          <>
            <h3>{server.title}</h3>
            <ServerState id={server.id} />
          </>
          <p class="muted">{server.description}</p>
          <button
            type="button"
            class="ip copyable"
            data-copy={server.address}
            title="Click to copy"
          >
            {server.address}
          </button>
        </div>
      ))
    }
  </section>
</BaseLayout>

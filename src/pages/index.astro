---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>

  <!-- Hero -->
  <section class="hero">
    <h1>Welcome to HulettCraft</h1>
    <p>
      A long-running survival community built around creativity,
      collaboration, and shared worlds.
    </p>
  </section>

  <!-- About -->
  <section class="hero" style="padding-top: 1rem;">
    <p
      style="
        max-width: 760px;
        margin: 0 auto;
        color: var(--muted);
        line-height: 1.7;
      "
    >
      HulettCraft is a multi-server community focused on vanilla survival,
      creative collaboration, and evolving seasonal experiences. We value
      long-term worlds, respectful play, and player-driven projects —
      with an eye toward the future through our active Hytale beta.
    </p>
  </section>

  <!-- Pillars -->
  <section class="server-grid">

    <div class="card">
      <h3>Long-Term Worlds</h3>
      <p style="color: var(--muted);">
        Our worlds are designed to last. Builds, infrastructure, and history
        matter here — nothing is treated as disposable.
      </p>
    </div>

    <div class="card">
      <h3>Community First</h3>
      <p style="color: var(--muted);">
        Light governance, shared responsibility, and collaboration define
        how we play together.
      </p>
    </div>

    <div class="card">
      <h3>Creative Freedom</h3>
      <p style="color: var(--muted);">
        From survival megabases to creative experiments and seasonal ideas,
        HulettCraft supports many playstyles.
      </p>
    </div>

  </section>

  <!-- Screenshots -->
  <section
    style="
      padding: 3rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    "
  >
    <h2 style="text-align: center; margin-bottom: 2rem;">
      A Look Inside the Worlds
    </h2>

    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      "
    >
      <!-- Replace filenames if needed -->
      <img
        src="/images/home/HCS4.jpg"
        alt="HulettCraft world screenshot"
        style="width: 100%; border-radius: 16px;"
      />
      <img
        src="/images/home/HulettcraftS7.jpg"
        alt="HulettCraft build screenshot"
        style="width: 100%; border-radius: 16px;"
      />
      <img
        src="/images/home/S6 Shops.jpg"
        alt="HulettCraft landscape screenshot"
        style="width: 100%; border-radius: 16px;"
      />
    </div>
  </section>

  <!-- CTA -->
  <section
    style="
      padding: 3rem 2rem;
      text-align: center;
      color: var(--muted);
    "
  >
    <p style="font-size: 1.1rem;">
      Ready to explore?
    </p>

    <p>
      <a href="/worlds" style="color: var(--text); margin-right: 1rem;">
        Explore our worlds →
      </a>
      <a href="/status" style="color: var(--text);">
        View live server status →
      </a>
    </p>
  </section>

</BaseLayout>

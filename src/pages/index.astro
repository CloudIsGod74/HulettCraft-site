---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>
  <section class="hero">
    <h1>HulettCraft</h1>
    <p>Vanilla SMP • Creative • Seasonal • Hytale (Beta)</p>
  </section>

  <section class="server-grid">

    <div class="card">
      <h3>Vanilla SMP</h3>
      <div class="node">Node: HulettCraft</div>
      <div class="ip">play.hulettcraft.com:25565</div>
      <div>Status: Online</div>
    </div>

    <div class="card">
      <h3>Creative Server</h3>
      <div class="node">Node: CloudCraft</div>
      <div class="ip">play.hulettcraft.com:25566</div>
      <div>Status: Online</div>
    </div>

    <div class="card">
      <h3>Seasonal Server</h3>
      <div class="node">Node: CloudCraft</div>
      <div class="ip">play.hulettcraft.com:25567</div>
      <div>Status: Online</div>
    </div>

    <div class="card">
      <h3>Hytale (Beta)</h3>
      <div class="node">Node: CloudCraft</div>
      <div class="ip">hytale.hulettcraft.com:12345</div>
      <div>Status: Online</div>
    </div>

  </section>
</BaseLayout>

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout>

  <section class="hero">
    <h1>HulettCraft — Season 1</h1>
    <p>
      The earliest days of the server — survival, experimentation,
      and the first shared history.
    </p>
  </section>

  <section
    style="
      padding: 3rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    "
  >
    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
      "
    >
      <img src="/images/gallery/hulettcraft/season-1/img1.jpg" style="width:100%; border-radius:16px;" />
      <img src="/images/gallery/hulettcraft/season-1/img2.jpg" style="width:100%; border-radius:16px;" />
      <img src="/images/gallery/hulettcraft/season-1/img3.jpg" style="width:100%; border-radius:16px;" />
    </div>
  </section>

  <section style="text-align:center; padding-bottom:3rem;">
    <a href="/gallery/hulettcraft" class="status-link">
      ← Back to seasons
    </a>
  </section>

</BaseLayout>

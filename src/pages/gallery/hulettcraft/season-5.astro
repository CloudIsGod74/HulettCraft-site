---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { HULETTCRAFT } from "../../../config/hulettcraft";

const season = Number(Astro.params.season);
const isCurrent = season === HULETTCRAFT.currentSeason;

const res = await fetch(
  new URL(`/api/gallery/hulettcraft/season/${season}`, Astro.url)
);
const screenshots = res.ok ? await res.json() : [];
---

<BaseLayout>
  <section class="hero">
    <h1>
      HulettCraft — Season 5{season}
      {isCurrent && (
        <span style="color: var(--green); margin-left: 0.5rem;">
          (Current)
        </span>
      )}
    </h1>

    <p>
      {isCurrent
        ? "The active season of HulettCraft, featuring ongoing survival and community builds."
        : "A completed season in the ongoing history of HulettCraft."}
    </p>
  </section>

  <section
    style="
      padding: 3rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    "
  >
    {screenshots.length === 0 ? (
      <p class="muted center">
        No screenshots yet for this season.
      </p>
    ) : (
      <div
        style="
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
          gap: 1.5rem;
        "
      >
        {screenshots.map((shot) => (
          <img
            src={shot.url}
            alt="HulettCraft screenshot"
            style="width:100%; border-radius:16px;"
            loading="lazy"
          />
        ))}
      </div>
    )}
  </section>

  <section style="text-align:center; padding-bottom:3rem;">
    <a href="/gallery/hulettcraft" class="status-link">
      ← Back to all seasons
    </a>
  </section>
</BaseLayout>

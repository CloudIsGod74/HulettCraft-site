---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { HULETTCRAFT } from "../../../config/hulettcraft";

const season = 3;
const isCurrent = season === HULETTCRAFT.currentSeason;
---
<BaseLayout>

  <section class="hero">
    <h1>
      HulettCraft — Season {season}
      {isCurrent && (
        <span style="color: var(--green); margin-left: 0.5rem;">
          (Current)
        </span>
      )}
    </h1>

    <p>
      {isCurrent
        ? "The active season of HulettCraft, featuring ongoing survival and community builds."
        : "A completed season in the ongoing history of HulettCraft."}
    </p>
  </section>

  <section
    style="
      padding: 3rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    "
  >
    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
      "
    >
      <img src="/images/gallery/hulettcraft/season-8/img1.jpg" style="width:100%; border-radius:16px;" />
      <img src="/images/gallery/hulettcraft/season-8/img2.jpg" style="width:100%; border-radius:16px;" />
      <img src="/images/gallery/hulettcraft/season-8/img3.jpg" style="width:100%; border-radius:16px;" />
    </div>
  </section>

  <section style="text-align:center; padding-bottom:3rem;">
    <a href="/gallery/hulettcraft" class="status-link">
      ← Back to all seasons
    </a>
  </section>

</BaseLayout>

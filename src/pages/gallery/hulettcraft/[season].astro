---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GalleryGrid from "../../../components/GalleryGrid.astro";
import { HULETTCRAFT } from "../../../config/hulettcraft";
import { requireAdmin } from "../../../lib/requireAdmin";
import { getBucket } from "../../../lib/runtime";
import { listGallery, type GalleryItem } from "../../../lib/gallery";
Astro.response.headers.set("Cache-Control", "private, no-store");
const match = Astro.params.season?.match(/^season-([1-9][0-9]{0,3}|unknown)$/);
const season = match?.[1];
if (!season) Astro.response.status = 404;
const config = season ? HULETTCRAFT.seasons[Number(season)] : undefined;
const admin = await requireAdmin(Astro.request, Astro.locals);
let images: GalleryItem[] = [],
  error = false;
if (season)
  try {
    images = await listGallery(getBucket(Astro.locals), "hulettcraft", season);
  } catch {
    error = true;
  }
---

<BaseLayout>
  <section class="hero">
    <h1>
      {
        season
          ? "HulettCraft — " +
            (season === "unknown" ? "Unassigned season" : "Season " + season)
          : "Season not found"
      }{
        Number(season) === HULETTCRAFT.currentSeason && (
          <span class="current-label"> (Current)</span>
        )
      }
    </h1>
    <p>
      {
        config?.description ??
          (season
            ? "A season in the history of HulettCraft."
            : "Choose a season from the gallery.")
      }
    </p>
  </section>
  <section class="gallery-panel">
    {
      error ? (
        <p role="alert">
          Screenshots could not be loaded. Please refresh or try again later.
        </p>
      ) : images.length ? (
        <GalleryGrid images={images} admin={admin} />
      ) : (
        season && (
          <p class="muted center">No screenshots yet for this season.</p>
        )
      )
    }
  </section>
  <p class="center">
    <a href="/gallery/hulettcraft" class="status-link">← Back to all seasons</a>
  </p>
</BaseLayout>

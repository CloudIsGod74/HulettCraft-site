---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { HULETTCRAFT } from "../../config/hulettcraft";
import { getBucket } from "../../lib/runtime";
import { seasonPreviews } from "../../lib/seasonPreviews";
import { listGallery } from "../../lib/gallery";
let error = false,
  unassigned = false;
let seasons = Object.entries(HULETTCRAFT.seasons)
  .map(([num, s]) => ({
    season: Number(num),
    ...s,
    previews: [] as string[],
    count: 0,
  }))
  .sort((a, b) => b.season - a.season);
try {
  const bucket = getBucket(Astro.locals);
  seasons = await seasonPreviews(bucket);
  unassigned = (await listGallery(bucket, "hulettcraft", "unknown")).length > 0;
} catch {
  error = true;
}
---

<BaseLayout>
  <section class="hero">
    <h1>HulettCraft</h1><p>
      A visual history of HulettCraft — worlds built, explored, and remembered
      across seasons.
    </p>
  </section>
  {
    error && (
      <p role="alert" class="center">
        Screenshot previews are temporarily unavailable. You can still browse
        the seasons below.
      </p>
    )
  }
  <section class="server-grid">
    {
      seasons.map((season) => (
        <div class="card card-link">
          <a
            href={"/gallery/hulettcraft/season-" + season.season}
            class="card-overlay"
            aria-label={season.title}
          />
          <h3>
            {season.title}
            {season.season === HULETTCRAFT.currentSeason && (
              <span class="season-badge current"> Current</span>
            )}
          </h3>
          <p class="muted">{season.tagline}</p>
          {season.previews.length > 0 && (
            <div class="preview-strip">
              {season.previews.map((src, i) => (
                <img
                  src={src}
                  alt={season.title + " preview " + (i + 1)}
                  loading="lazy"
                />
              ))}
            </div>
          )}
        </div>
      ))
    }
  </section>
  {
    unassigned && (
      <p class="center">
        <a href="/gallery/hulettcraft/season-unknown">
          View screenshots with an unassigned season
        </a>
      </p>
    )
  }
</BaseLayout>

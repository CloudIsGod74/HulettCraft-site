---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { HULETTCRAFT } from "../../config/hulettcraft";

// Sort seasons newest → oldest
const seasons = Object.keys(HULETTCRAFT.seasons)
  .map(Number)
  .sort((a, b) => b - a);

const current = HULETTCRAFT.currentSeason;
---

<BaseLayout>

  <!-- Hero -->
  <section class="hero">
    <h1>Gallery</h1>
    <p>
      A visual history of HulettCraft — worlds built, explored,
      and remembered across seasons.
    </p>
  </section>

  <section class="gallery-seasons">

    {seasons.map(seasonNum => {
      const season = HULETTCRAFT.seasons[seasonNum];
      const isCurrent = seasonNum === current;

      return (
        <section class="season-block">
          <header class="season-header">
            <h2>
              {season.title}
              {isCurrent && <span class="season-badge current">Current</span>}
            </h2>
            <p class="season-tagline">{season.tagline}</p>
          </header>

          <div class="gallery-grid">
 		 {season.images?.map((src, i) => (
  		  <img
    		  src={src}
     		 alt={`${season.title} screenshot ${i + 1}`}
     		 loading="lazy"
   		 />
 		 ))}
		
 	 {!season.images?.length && (
   	 <p class="muted">No screenshots available yet.</p>
  		)}
	</div>
        </section>
      );
    })}

  </section>

</BaseLayout>

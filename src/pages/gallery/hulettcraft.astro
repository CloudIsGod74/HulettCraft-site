---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout>

  <section class="hero">
    <h1>HulettCraft</h1>
    <p>
      The long-running survival history of HulettCraft,
      organized by season.
    </p>
  </section>

  <section class="server-grid">

    <div class="card">
      <h3>Season 1</h3>
      <p style="color: var(--muted);">
        The beginning — early survival, first community builds,
        and the foundations of HulettCraft.
      </p>
      <div class="card-actions">
        <a href="/gallery/hulettcraft/season-1" class="status-link">
          View season →
        </a>
      </div>
    </div>

    <div class="card">
      <h3>Season 2</h3>
      <p style="color: var(--muted);">

---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout>

  <section class="hero">
    <h1>Hytale</h1>
    <p>
      Early exploration, builds, and moments from the Hytale beta.
    </p>
  </section>

  <section
    style="
      padding: 3rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    "
  >
    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
      "
    >
      <img src="/images/gallery/hytale/img1.jpg" style="width:100%; border-radius:16px;" />
      <img src="/images/gallery/hytale/img2.jpg" style="width:100%; border-radius:16px;" />
      <!-- add more freely -->
    </div>
  </section>

</BaseLayout>

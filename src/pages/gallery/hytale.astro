---
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorldGallery from "../../components/WorldGallery.astro";
---

<BaseLayout>
  <PageHero>
    <h1>Hytale</h1><p>
      Early exploration, builds, and moments from the Hytale beta.
    </p>
  </PageHero>
  <WorldGallery world="hytale" />
  <section class="gallery-panel">
    <h2>From the early days</h2><div class="season-grid">
      <img
        src="/images/gallery/hytale/cloudnhwoarong.jpg"
        alt="Hytale community screenshot"
        loading="lazy"
      />
      <img
        src="/images/gallery/hytale/hytaleserver.jpg"
        alt="Hytale server landscape"
        loading="lazy"
      />
    </div>
  </section>
</BaseLayout>

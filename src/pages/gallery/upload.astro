---
import BaseLayout from "../../layouts/BaseLayout.astro";

const url = new URL(Astro.request.url);
const success = url.searchParams.get("success") === "1";
---

<BaseLayout>
  {
    success && (
      <div
        style="
      margin: 2rem auto;
      max-width: 720px;
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.4);
      padding: 1rem 1.25rem;
      border-radius: 10px;
      color: #e5e7eb;
    "
      >
        ✅{" "}
        <>
          <strong>Submission successful!</strong>
          <br />
        </>
        Your screenshot has been sent for admin approval.
      </div>
    )
  }

  <!-- Hero -->
  <section class="hero">
    <h1>Submit a Screenshot</h1>
    <p>
      Share moments from HulettCraft. All submissions are reviewed before
      appearing in the gallery.
    </p>
  </section>

  <section class="upload-panel">
    <form
      class="upload-form"
      method="POST"
      action="/api/screenshots/upload"
      enctype="multipart/form-data"
    >
      <!-- Screenshot -->
      <label>
        Screenshot
        <input
          type="file"
          name="screenshot"
          accept="image/png,image/jpeg,image/webp,image/gif"
          required
        />
      </label>

      <!-- World -->
      <label>
        World
        <select name="world" required>
          <option value="">Select a world</option>
          <option value="hulettcraft">HulettCraft</option>
          <option value="modded">Modded</option>
          <option value="hytale">Hytale</option>
        </select>
      </label>

      <!-- Season -->
      <label>
        Season <span class="muted">(optional)</span>
        <input type="number" name="season" placeholder="e.g. 8" min="1" />
      </label>

      <!-- Description -->
      <label>
        Description <span class="muted">(optional)</span>
        <textarea
          name="description"
          rows="3"
          placeholder="What’s happening in this screenshot?"></textarea>
      </label>

      <!-- Name / Discord -->
      <label>
        Your name or Discord <span class="muted">(optional)</span>
        <input type="text" name="author" placeholder="Cloud / username#1234" />
      </label>

      <!-- Submit -->
      <button type="submit" class="submit-btn"> Submit for approval </button>

      <p class="upload-note">
        PNG, JPEG, GIF, or WebP; up to 10 MiB and 40 megapixels. Screenshots are
        reviewed before publication.
      </p>

      <p class="upload-result" role="status" aria-live="polite"></p>
    </form>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>(".upload-form");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>(".upload-result"),
        button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      if (status) status.textContent = "Uploading…";
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
        });
        if (response.redirected && response.ok) {
          window.location.assign(response.url);
          return;
        }
        throw new Error(await response.text());
      } catch (error) {
        if (status)
          status.textContent =
            error instanceof Error
              ? error.message
              : "Upload failed. Please try again.";
        if (button) button.disabled = false;
      }
    });
  </script></BaseLayout
>

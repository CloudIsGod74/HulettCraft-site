---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../lib/requireAdmin";

Astro.response.headers.set("Cache-Control", "private, no-store");
const admin = await requireAdmin(Astro.request, Astro.locals);
if (!admin) return Astro.redirect("/admin/login");
---

<BaseLayout>
  <h1>Bulk Upload Screenshots</h1>
  <p>
    <a href="/admin/roster">Manage member roster</a> · <a href="/admin/pending"
      >Pending screenshots</a>
  </p>
  <p class="subtitle">Admin-only direct upload (skips approval)</p>

  <input
    type="file"
    id="fileInput"
    multiple
    accept="image/png,image/jpeg,image/webp,image/gif"
    hidden
  />

  <button type="button" id="dropzone">
    Drag images here or click to select
  </button>

  <form id="uploadForm">
    <p id="upload-result" role="status" aria-live="polite"></p><div
      class="table-scroll"
    >
      <table id="uploadTable">
        <thead>
          <tr>
            <th>Preview</th>
            <th>Filename</th>
            <th>World</th>

            <!-- Season header with centered label + dropdown -->
            <th class="season-header">
              <div class="season-header-inner">
                <span>Season</span>
                <select
                  id="bulkSeasonHeader"
                  aria-label="Set season for all images"
                >
                  <option value="">—</option>
                </select>
              </div>
            </th>

            <th>Description</th>
            <th>Author</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>

    <div class="actions">
      <button type="submit">Upload all</button>
    </div>
  </form>
</BaseLayout>

<style>
  .subtitle {
    opacity: 0.75;
    margin-bottom: 1.25rem;
  }

  #dropzone {
    border: 2px dashed #2fa36b;
    background: rgba(15, 30, 40, 0.6);
    padding: 1.5rem;
    text-align: center;
    cursor: pointer;
    margin-bottom: 1.5rem;
    border-radius: 8px;
  }

  table {
    width: 100%;
    background: rgba(10, 20, 30, 0.75);
    border-radius: 10px;
    overflow: hidden;
  }

  thead {
    background: rgba(20, 40, 55, 0.95);
  }

  th {
    padding: 0.75rem;
    text-transform: uppercase;
    font-size: 0.8rem;
    border-bottom: 2px solid #2fa36b;
    text-align: left;
  }

  td {
    padding: 0.5rem;
  }

  .preview {
    width: 96px;
    height: 54px;
    object-fit: cover;
    border-radius: 6px;
  }

  /* Inputs & selects */
  input,
  select {
    width: 100%;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: white;
    padding: 0.4rem;
    border-radius: 6px;
    font-size: 0.85rem;
  }

  /* Season column sizing & centering */
  .season-header {
    width: 120px;
  }

  .season-header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .season-header-inner span {
    white-space: nowrap;
  }

  .season-header-inner select {
    width: 4.5rem;
  }

  .season-cell {
    width: 120px;
    text-align: center;
  }

  .season-cell select {
    width: 4.5rem;
  }

  /* Actions */
  .actions {
    margin-top: 1rem;
    text-align: right;
  }

  .actions button {
    background: #2fa36b;
    border: none;
    padding: 0.6rem 1.2rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
  }
</style>

<script>
  import "../../scripts/bulkUpload";
</script>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../lib/requireAdmin";

const admin = await requireAdmin(Astro.request, Astro.locals);
if (!admin) return Astro.redirect("/admin/login");

let screenshots: any[] = [];

try {
  const res = await fetch(new URL("/api/admin/pending", Astro.url), {
    headers: {
      cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });

  if (!res.ok) {
    throw new Error(`Pending API failed: ${res.status}`);
  }

  screenshots = await res.json();
} catch (err) {
  console.error("FAILED TO LOAD PENDING:", err);
  screenshots = [];
}
---

<BaseLayout>
  <section class="hero">
    <h1>Pending Screenshots</h1>
    <p>Awaiting admin approval</p>
  </section>

  <!-- Bulk actions -->
  <section class="bulk-actions">
    <div class="bulk-left">
      <label>
        <input type="checkbox" id="select-all" />
        Select all
      </label>

      <button id="bulk-approve" class="btn approve">
        Approve selected
      </button>

      <button id="bulk-reject" class="btn reject">
        Reject selected
      </button>
    </div>

    <div class="bulk-right">
      <a href="/admin/bulk-upload" class="btn bulk-upload">
        Bulk Upload Screenshots
      </a>
    </div>
  </section>

  <section id="pending-list" class="pending-list">
    {screenshots.length === 0 && (
      <p class="muted center">No pending screenshots 🎉</p>
    )}

    {screenshots.map((shot) => (
      <div class="pending-card" data-key={shot.key}>
        <input
          type="checkbox"
          class="bulk-checkbox"
          data-key={shot.key}
        />

        <img src={shot.previewUrl} alt="Pending screenshot" />

        <div class="edit-fields">
          <textarea
            class="edit-description"
            placeholder="Description (optional)"
          >{shot.metadata?.description ?? ""}</textarea>

          <input
            type="text"
            class="edit-author"
            placeholder="Author (optional)"
            value={shot.metadata?.author ?? ""}
          />
        </div>

        <div class="meta">
          <small>
            Uploaded {new Date(shot.uploadedAt).toLocaleString()}
          </small>

          <div class="actions">
            <button class="btn approve" data-key={shot.key}>
              Approve
            </button>
            <button class="btn reject" data-key={shot.key}>
              Reject
            </button>
          </div>
        </div>
      </div>
    ))}
  </section>

  <style>
    .bulk-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 2rem 0;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .bulk-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .bulk-right {
      display: flex;
      align-items: center;
    }

    .btn {
      padding: 0.45rem 0.9rem;
      border-radius: 6px;
      border: 1px solid transparent;
      font-size: 0.85rem;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.15s ease, opacity 0.15s ease;
    }

    .btn.approve {
      background: rgba(47, 163, 107, 0.85);
      color: #000;
    }

    .btn.approve:hover {
      background: rgba(47, 163, 107, 1);
    }

    .btn.reject {
      background: rgba(220, 70, 70, 0.85);
      color: #000;
    }

    .btn.reject:hover {
      background: rgba(220, 70, 70, 1);
    }

    .btn.bulk-upload {
      background: rgba(70, 140, 220, 0.9);
      color: #000;
      text-decoration: none;
    }

    .btn.bulk-upload:hover {
      background: rgba(70, 140, 220, 1);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>

<script type="module">
  async function action(button, endpoint) {
    const card = button.closest(".pending-card");
    const key = button.dataset.key;

    const payload = { key };

    if (endpoint.includes("approve")) {
      payload.updates = {
        [key]: {
          description:
            card.querySelector(".edit-description")?.value ?? "",
          author:
            card.querySelector(".edit-author")?.value ?? "",
        },
      };
    }

    card.style.opacity = "0.5";
    button.disabled = true;

    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error(await res.text());
      card.remove();
    } catch (err) {
      console.error(err);
      alert("Action failed. See console.");
      card.style.opacity = "1";
      button.disabled = false;
    }
  }

  document.querySelectorAll(".approve").forEach((btn) => {
    btn.addEventListener("click", () =>
      action(btn, "/api/admin/approve")
    );
  });

  document.querySelectorAll(".reject").forEach((btn) => {
    btn.addEventListener("click", () =>
      action(btn, "/api/admin/reject")
    );
  });
</script>

<script type="module">
  const selectAll = document.getElementById("select-all");

  function getSelectedKeys() {
    return Array.from(
      document.querySelectorAll(".bulk-checkbox:checked")
    ).map((cb) => cb.dataset.key);
  }

  selectAll?.addEventListener("change", () => {
    document
      .querySelectorAll(".bulk-checkbox")
      .forEach((cb) => (cb.checked = selectAll.checked));
  });

  async function bulkAction(endpoint) {
    const keys = getSelectedKeys();
    if (!keys.length) return;

    const updates = {};
    keys.forEach((key) => {
      const card = document.querySelector(
        `.pending-card[data-key="${key}"]`
      );

      updates[key] = {
        description:
          card.querySelector(".edit-description")?.value ?? "",
        author:
          card.querySelector(".edit-author")?.value ?? "",
      };
    });

    const res = await fetch(endpoint, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ keys, updates }),
    });

    if (!res.ok) {
      alert("Bulk action failed");
      return;
    }

    keys.forEach((key) => {
      document
        .querySelector(`.pending-card[data-key="${key}"]`)
        ?.remove();
    });
  }

  document
    .getElementById("bulk-approve")
    ?.addEventListener("click", () =>
      bulkAction("/api/admin/approve")
    );

  document
    .getElementById("bulk-reject")
    ?.addEventListener("click", () =>
      bulkAction("/api/admin/reject")
    );
</script>
</BaseLayout>

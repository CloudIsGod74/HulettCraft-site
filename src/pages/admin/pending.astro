---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../lib/requireAdmin";

const admin = await requireAdmin(Astro.request, Astro.locals);
if (!admin) return Astro.redirect("/admin/login");

let screenshots: any[] = [];

try {
  const res = await fetch(new URL("/api/admin/pending", Astro.url), {
    headers: {
      cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });

  if (!res.ok) {
    throw new Error(`Pending API failed: ${res.status}`);
  }

  screenshots = await res.json();
} catch (err) {
  console.error("FAILED TO LOAD PENDING:", err);
  screenshots = [];
}
---

<BaseLayout>
  <section class="hero">
    <h1>Pending Screenshots</h1>
    <p>Awaiting admin approval</p>
  </section>

  <section class="bulk-actions">
    <label>
      <input type="checkbox" id="select-all" />
      Select all
    </label>

    <button id="bulk-approve" class="approve">
      Approve selected
    </button>

    <button id="bulk-reject" class="reject">
      Reject selected
    </button>
  </section>


  <section id="pending-list" class="pending-list">
    {screenshots.length === 0 && (
      <p class="muted center">No pending screenshots 🎉</p>
    )}

    {screenshots.map((shot) => (
      <div class="pending-card" data-key={shot.key}>
 	 <input
   	  type="checkbox"
  	  class="bulk-checkbox"
   	  data-key={shot.key}
  	 />

        <img src={shot.previewUrl} alt="Pending screenshot" />

	<div class="edit-fields">
 	 <textarea
	    class="edit-description"
	    placeholder="Description (optional)"
	  >{shot.metadata?.description ?? ""}</textarea>

	  <input
	    type="text"
	    class="edit-author"
	    placeholder="Author (optional)"
	    value={shot.metadata?.author ?? ""}
	  />
	</div>

	<div class="meta">

          <small>
		Uploaded {new Date(shot.uploadedAt).toLocaleString()}
	  </small>

          <div class="actions">
            <button class="approve" data-key={shot.key}>Approve</button>
            <button class="reject" data-key={shot.key}>Reject</button>
          </div>
        </div>
      </div>
    ))}
  </section>

<script type="module">
  async function action(button, endpoint) {
    const card = button.closest(".pending-card");
    const key = button.dataset.key;

    const payload = { key };

    if (endpoint.includes("approve")) {
      payload.updates = {
       [key]: {
        description:
          card.querySelector(".edit-description")?.value ?? "",
        author:
          card.querySelector(".edit-author")?.value ?? "",	
	    },
	  };
	}

    // Optimistic UI
    card.style.opacity = "0.5";
    button.disabled = true;

    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error(await res.text());

      // Remove card on success
      card.remove();
    } catch (err) {
      console.error(err);
      alert("Action failed. See console.");
      card.style.opacity = "1";
      button.disabled = false;
    }
  }

  document.querySelectorAll(".approve").forEach((btn) => {
    btn.addEventListener("click", () =>
      action(btn, "/api/admin/approve")
    );
  });

  document.querySelectorAll(".reject").forEach((btn) => {
    btn.addEventListener("click", () =>
      action(btn, "/api/admin/reject")
    );
  });
</script>

<script type="module">
  async function loadPending() {
    try {
      const res = await fetch("/api/admin/pending", {
        credentials: "same-origin",
      });

      if (!res.ok) return;

      const shots = await res.json();

      if (!shots.length) {
        container.innerHTML =
          `<p class="muted center">No pending screenshots 🎉</p>`;
        return;
      }

      container.innerHTML = shots
        .map(
          (shot) => `
          <div class="pending-card" data-key="${shot.key}">
            <img src="${shot.previewUrl}" alt="Pending screenshot" />

            <div class="meta">
              <small>
                Uploaded ${new Date(shot.uploadedAt).toLocaleString()}
              </small>

              <div class="actions">
                <button class="approve" data-key="${shot.key}">Approve</button>
                <button class="reject" data-key="${shot.key}">Reject</button>
              </div>
            </div>
          </div>
        `
        )
        .join("");
    } catch (err) {
      console.error("Auto-refresh failed", err);
    }
  }

  // Refresh every 10 seconds
 // setInterval(loadPending, 10000);
</script>

<script type="module">
  const list = document.getElementById("pending-list");
  const selectAll = document.getElementById("select-all");

  function getSelectedKeys() {
    return Array.from(
      document.querySelectorAll(".bulk-checkbox:checked")
    ).map((cb) => cb.dataset.key);
  }

  // Select all toggle
  selectAll?.addEventListener("change", () => {
    document
      .querySelectorAll(".bulk-checkbox")
      .forEach((cb) => (cb.checked = selectAll.checked));
  });

async function bulkAction(endpoint) {
  const keys = getSelectedKeys();
  if (!keys.length) return;

  // Build metadata overrides
  const updates = {};
  keys.forEach((key) => {
    const card = document.querySelector(
      `.pending-card[data-key="${key}"]`
    );

    updates[key] = {
      description:
        card.querySelector(".edit-description")?.value ?? "",
      author:
        card.querySelector(".edit-author")?.value ?? "",
    };
  });

  const res = await fetch(endpoint, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ keys, updates }),
  });

  if (!res.ok) {
    alert("Bulk action failed");
    return;
  }

  // Remove cards instantly
  keys.forEach((key) => {
    document
      .querySelector(`.pending-card[data-key="${key}"]`)
      ?.remove();
  });
}


  document
    .getElementById("bulk-approve")
    ?.addEventListener("click", () =>
      bulkAction("/api/admin/approve")
    );

  document
    .getElementById("bulk-reject")
    ?.addEventListener("click", () =>
      bulkAction("/api/admin/reject")
    );
</script>

</BaseLayout>

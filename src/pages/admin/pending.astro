---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../lib/requireAdmin";

const admin = await requireAdmin(Astro.request, Astro.locals);
if (!admin) return Astro.redirect("/admin/login");

let screenshots: any[] = [];

try {
  const res = await fetch(new URL("/api/admin/pending", Astro.url), {
    headers: {
      cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });

  if (!res.ok) {
    throw new Error(`Pending API failed: ${res.status}`);
  }

  screenshots = await res.json();
} catch (err) {
  console.error("FAILED TO LOAD PENDING:", err);
  screenshots = [];
}
---

<BaseLayout>
  <section class="hero">
    <h1>Pending Screenshots</h1>
    <p>Awaiting admin approval</p>
  </section>

  <section class="pending-list">
    {screenshots.length === 0 && (
      <p class="muted center">No pending screenshots 🎉</p>
    )}

    {screenshots.map((shot) => (
      <div class="pending-card">
        <img src={shot.url} alt="Pending screenshot" />

        <div class="meta">
          <small>Uploaded {new Date(shot.uploadedAt).toLocaleString()}</small>

          <div class="actions">
            <button class="approve" data-key={shot.key}>Approve</button>
            <button class="reject" data-key={shot.key}>Reject</button>
          </div>
        </div>
      </div>
    ))}
  </section>

<script type="module">
  async function action(button, endpoint) {
    const card = button.closest(".pending-card");
    const key = button.dataset.key;

    // Optimistic UI
    card.style.opacity = "0.5";
    button.disabled = true;

    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ key }),
      });

      if (!res.ok) throw new Error(await res.text());

      // Remove card on success
      card.remove();
    } catch (err) {
      console.error(err);
      alert("Action failed. See console.");
      card.style.opacity = "1";
      button.disabled = false;
    }
  }

  document.querySelectorAll(".approve").forEach((btn) => {
    btn.addEventListener("click", () =>
      action(btn, "/api/admin/approve")
    );
  });

  document.querySelectorAll(".reject").forEach((btn) => {
    btn.addEventListener("click", () =>
      action(btn, "/api/admin/reject")
    );
  });
</script>

</BaseLayout>

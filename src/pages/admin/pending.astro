---
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireAdmin } from "../../lib/requireAdmin";
import { listPending, type GalleryItem } from "../../lib/gallery";
import { getBucket } from "../../lib/runtime";
Astro.response.headers.set("Cache-Control", "private, no-store");
const admin = await requireAdmin(Astro.request, Astro.locals);
if (!admin) return Astro.redirect("/admin/login");
let screenshots: GalleryItem[] = [],
  loadError = false;
try {
  screenshots = await listPending(getBucket(Astro.locals));
} catch {
  loadError = true;
}
---

<BaseLayout>
  <PageHero>
    <h1>Pending Screenshots</h1>
    <p>Awaiting admin approval</p><form
      method="POST"
      action="/api/admin/auth/logout"
    >
      <button type="submit">Log out</button>
    </form>
  </PageHero>

  <!-- Bulk actions -->
  <section class="bulk-actions">
    <div class="bulk-left">
      <label>
        <input type="checkbox" id="select-all" />
        Select all
      </label>

      <button id="bulk-approve" class="btn approve"> Approve selected </button>

      <button id="bulk-reject" class="btn reject"> Reject selected </button>
    </div>

    <div class="bulk-right">
      <a href="/admin/modded" class="btn bulk-upload">Modded client setup</a>
      <a href="/admin/applications" class="btn bulk-upload">Join applications</a
      >
      <a href="/admin/roster" class="btn bulk-upload">Manage member roster</a>
      <a href="/admin/bulk-upload" class="btn bulk-upload">
        Bulk Upload Screenshots
      </a>
    </div>
  </section>

  <p id="moderation-result" role="status" aria-live="polite"></p>
  {
    loadError && (
      <p role="alert">
        Pending screenshots could not be loaded. Please refresh or try again
        later.
      </p>
    )
  }
  <section id="pending-list" class="pending-list">
    {
      !loadError && screenshots.length === 0 && (
        <p class="muted center">No pending screenshots 🎉</p>
      )
    }

    {
      screenshots.map((shot) => (
        <div class="pending-card" data-key={shot.key}>
          <input
            type="checkbox"
            class="bulk-checkbox"
            aria-label={"Select " + shot.filename}
            data-key={shot.key}
          />

          <img src={shot.previewUrl} alt="Pending screenshot" />

          <div class="edit-fields">
            <textarea
              class="edit-description"
              placeholder="Description (optional)"
              aria-label="Screenshot description"
              maxlength="2000"
              set:text={shot.metadata.description ?? ""}
            />

            <input
              type="text"
              class="edit-author"
              placeholder="Author (optional)"
              aria-label="Screenshot author"
              maxlength="100"
              value={shot.metadata?.author ?? ""}
            />
          </div>

          <div class="meta">
            <small>Uploaded {new Date(shot.uploadedAt).toLocaleString()}</small>

            <div class="actions">
              <button class="btn approve" data-key={shot.key}>
                Approve
              </button>
              <button class="btn reject" data-key={shot.key}>
                Reject
              </button>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <style>
    .bulk-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 2rem 0;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .bulk-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .bulk-right {
      gap: 0.75rem;
      flex-wrap: wrap;
      display: flex;
      align-items: center;
    }

    .btn {
      padding: 0.45rem 0.9rem;
      border-radius: 6px;
      border: 1px solid transparent;
      font-size: 0.85rem;
      cursor: pointer;
      font-weight: 600;
      transition:
        background 0.15s ease,
        opacity 0.15s ease;
    }

    .btn.approve {
      background: rgba(47, 163, 107, 0.85);
      color: #000;
    }

    .btn.approve:hover {
      background: rgba(47, 163, 107, 1);
    }

    .btn.reject {
      background: rgba(220, 70, 70, 0.85);
      color: #000;
    }

    .btn.reject:hover {
      background: rgba(220, 70, 70, 1);
    }

    .btn.bulk-upload {
      background: rgba(70, 140, 220, 0.9);
      color: #000;
      text-decoration: none;
    }

    .btn.bulk-upload:hover {
      background: rgba(70, 140, 220, 1);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>

  <script>
    import "../../scripts/moderation";
  </script>
</BaseLayout>

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import { requireAdmin } from "../../../lib/requireAdmin";
import { listApplications } from "../../../lib/applications";
import {
  APPLICATION_STATUSES,
  APPLICATION_VIEWS,
  applicationView,
  applicationListHref,
} from "../../../config/applications";
Astro.response.headers.set("Cache-Control", "private, no-store");
if (!(await requireAdmin(Astro.request, Astro.locals)))
  return Astro.redirect("/admin/login");
const view = applicationView(Astro.url.searchParams.get("view"));
let page: Awaited<ReturnType<typeof listApplications>> | undefined;
try {
  page = await listApplications(
    Astro.locals,
    Astro.url.searchParams.get("cursor") || undefined,
    view,
  );
} catch (error) {
  Astro.response.status = error instanceof Response ? error.status : 503;
}
---

<BaseLayout title="Join applications | HulettCraft Admin">
  <PageHero
    ><h1>Join applications</h1><p>
      Private introductions from people who would like to join HulettCraft SMP.
    </p></PageHero
  >
  <nav class="admin-roster-nav" aria-label="Administrator tools">
    <a href="/admin/pending">Pending screenshots</a><a href="/admin/roster"
      >Member roster</a
    ><a href="/join">View application form</a>
  </nav>
  <p class="muted">
    Newest submissions appear first. New applications and review updates may
    take about a minute to appear. Please use one reviewer per application at a
    time.
  </p>
  <nav class="application-views" aria-label="Application views">
    {
      APPLICATION_VIEWS.map((option) => (
        <a
          href={applicationListHref(option.value)}
          aria-current={view === option.value ? "page" : undefined}
        >
          {option.label}
        </a>
      ))
    }
  </nav>
  <p class="muted">
    {
      view === "active"
        ? "New and in-review applications. Accepted and declined requests are saved under Completed."
        : view === "completed"
          ? "Accepted and declined applications, saved for later reference. Change a review status to New or In review to return it to Active."
          : "All applications, including accepted and declined requests."
    }
  </p>
  {
    !page ? (
      <p role="alert">
        Applications could not be loaded. Please refresh or try again later.
      </p>
    ) : (
      <>
        {page.applications.length === 0 && (
          <p class="card">
            {page.cursor
              ? "No matching applications in this section. Continue to check older submissions."
              : view === "active"
                ? "No active applications here. You’re caught up; past decisions are under Completed."
                : view === "completed"
                  ? "No completed applications here yet. Accepted and declined requests will appear here."
                  : "No applications on this page yet."}
          </p>
        )}
        <div class="application-list">
          {page.applications.map((application) => (
            <a
              class="card application-summary"
              href={
                "/admin/applications/" +
                application.id +
                (view === "active" ? "" : "?view=" + view)
              }
            >
              <div>
                <p class="eyebrow">
                  {
                    APPLICATION_STATUSES.find(
                      (status) => status.value === application.status,
                    )?.label
                  }
                </p>
                <h2>{application.minecraft}</h2>
                <p class="muted">
                  Submitted{" "}
                  <time datetime={application.createdAt}>
                    {new Date(application.createdAt).toLocaleString("en-US", {
                      timeZone: "America/Chicago",
                      dateStyle: "medium",
                      timeStyle: "short",
                    })}{" "}
                    Central
                  </time>
                </p>
              </div>
              <span>Read application →</span>
            </a>
          ))}
        </div>
        {page.cursor && (
          <p>
            <a
              class="application-next"
              href={applicationListHref(view, page.cursor)}
            >
              Next page →
            </a>
          </p>
        )}
        {Astro.url.searchParams.has("cursor") && (
          <p>
            <a class="application-next" href={applicationListHref(view)}>
              Back to newest applications
            </a>
          </p>
        )}
      </>
    )
  }
</BaseLayout>
